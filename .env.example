# Copy to .env and fill in. Never commit .env.

# --- Local LLM (llama.cpp) -------------------------------------------------
# llama-server listens on 8081 because Oracle TNSLSNR commonly owns 8080.
LLAMA_SERVER_URL=http://127.0.0.1:8081
LLAMA_MODEL_PATH=D:\Gen AI Applications\LLMS\gemma-3-1b-it-Q4_K_M.gguf
# Unzip a llama-b*-bin-win-cpu-x64.zip release into tools/llama-bin/ or point
# at an existing release folder. With neither, classification runs rules-only.
LLAMA_BIN_DIR=C:\Users\Admin\AppData\Local\Temp\opencode\llama-bin

# --- PayPal Sandbox --------------------------------------------------------
# Leave both empty to disable invoicing; the preview endpoint still works.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_INVOICE_EMAIL=buyer@example.com
PAYPAL_INVOICE_NAME=Gabriel Mendez
PAYPAL_INVOICE_CURRENCY=USD

# --- Agent Reach -----------------------------------------------------------
# YouTube (yt-dlp) is required by FR-19; RSS always works; Exa needs
# `mcporter` installed AND an `exa` MCP server registered (FR-20).
AGENT_REACH_ENABLED=true
AGENT_REACH_YT_LIMIT=12
AGENT_REACH_EXA_LIMIT=5
AGENT_REACH_SUB_LIMIT=3
YT_DLP_BIN=yt-dlp
MCPORTER_BIN=mcporter
TREND_CACHE_HOURS=24

# --- Server ----------------------------------------------------------------
PORT=3000